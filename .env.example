# Flows Scan (zelva-agent) — plantilla de entorno
#
# Copia a .env y llena los valores. El .env esta en .gitignore; este ejemplo NO,
# asi que aca van solo nombres y defaults inocuos, nunca claves reales.
#
# Las 9 variables que el codigo lee, verificadas el 2026-11-03. Ver AGENTS.md §3.

# ── Servidor local ────────────────────────────────────────────────────────────
AGENT_PORT=3002

# ── Conexion con ZALVAJE ──────────────────────────────────────────────────────
# A donde deposita los scans. En desarrollo: http://localhost:3001
ZALVAJE_BACKEND=https://zalvaje-backend.onrender.com

# TIENE que coincidir con la variable AGENT_KEY del backend en Render.
# Es la credencial propia del agente: /api/agent esta exento del guard
# X-Zelva-Key y valida con el header x-agent-key contra este valor.
#
# ⚠ La clave anterior quedo con su valor real en el historial de git. Hay que
#   rotarla: valor nuevo aca Y en Render. Ver AGENTS.md §0.
AGENT_KEY=

# ── IA ────────────────────────────────────────────────────────────────────────
# Gemini 2.5 Flash por REST, para el resumen del scan (src/aiSummary.ts).
GEMINI_API_KEY=

# ── Notificaciones (CallMeBot por WhatsApp) ───────────────────────────────────
# Numero destino con indicativo y sin el +, p. ej. 573001234567.
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
# Recuerda: el mensaje va en la URL, asi que debe quedar bajo ~900 caracteres
# o la peticion falla por longitud.

# ── Depuracion ────────────────────────────────────────────────────────────────
# false abre Chrome visible. Es la forma mas rapida de depurar un scraper.
HEADLESS=true

# ── Tunel (Cloudflare Quick Tunnel) ───────────────────────────────────────────
# Ruta al binario de cloudflared. El default del codigo es el de Windows.
CLOUDFLARED_PATH=C:\Program Files (x86)\cloudflared\cloudflared.exe

# 1 arranca sin tunel, para desarrollo local contra un backend local.
# AGENT_DISABLE_TUNNEL=1
